        554
      ],
      "block_id": "ocr_0005_2f405c2c",
      "source_hash": "47cfde5e68ef964f",
      "reference_text": "It's been a while since we found a town huh? Now I can stretch my wings a bit.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_006",
      "page_order": 6,
      "source_text": "フリーレン様どうします？",
      "source_box": [
        707,
