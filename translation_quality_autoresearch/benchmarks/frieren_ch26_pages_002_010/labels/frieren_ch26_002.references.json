        298
      ],
      "block_id": "ocr_0002_dac998c2",
      "source_hash": "e4ba0fbeacca7930",
      "reference_text": "Well then, after we set down our luggage inside the inn, we'll have free time until evening",
      "alignment_confidence": "high",
