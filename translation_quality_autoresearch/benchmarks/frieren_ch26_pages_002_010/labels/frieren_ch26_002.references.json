      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_007",
      "page_order": 7,
      "source_text": "私はいいや。",
      "source_box": [
        534,
        713,
        556,
        827
      ],
      "block_id": "ocr_0008_ac9793b7",
      "source_hash": "7ff5c34c2450f185",
      "reference_text": "I'm fine.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_008",
      "page_order": 8,
      "source_text": "そうですか。じゃあ私一人で．．．",
      "source_box": [
        322,
        633,
        404,
        749
      ],
      "block_id": "ocr_0009_b02d123f",
      "source_hash": "337b33606a931ea7",
      "reference_text": "Is that so. Well then, on my own...",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_009",
      "page_order": 9,
      "source_text": "あ、そうだ。今日はシュタルクの１８歳の誕生日だから。",
      "source_box": [
        46,
        629,
        162,
        820
      ],
      "block_id": "ocr_0011_5a699ef8",
      "source_hash": "bbf40c6a43b9a046",
      "reference_text": "Ah, that reminds me. Today is Stark's 18th birthday.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_010",
      "page_order": 10,
      "source_text": "一緒にお店とか見て回りますか？",
