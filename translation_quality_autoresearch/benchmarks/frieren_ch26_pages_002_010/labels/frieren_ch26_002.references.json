      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_002",
      "line_id": "002_005",
      "page_order": 5,
      "source_text": "久々の町だな。羽を伸ばせるぜ。",
