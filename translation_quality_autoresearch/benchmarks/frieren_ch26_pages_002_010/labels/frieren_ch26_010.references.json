      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_010",
      "line_id": "010_007",
      "page_order": 7,
      "source_text": "．．降ってきやがった。",
      "source_box": [
        99,
