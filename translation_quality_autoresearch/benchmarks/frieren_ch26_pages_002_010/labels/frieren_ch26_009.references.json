  "labels": [
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_001",
      "page_order": 1,
      "source_text": "いやふざけていたわけじゃなくて．．．",
      "source_box": [
        651,
        110,
        730,
        279
      ],
      "block_id": "ocr_0001_360393a4",
      "source_hash": "7b16eb4f7681a5a3",
      "reference_text": "No, I wasn't trying to joke around...",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_002",
      "page_order": 2,
      "source_text": "俺、誕生日にプレゼントとか貰ったことないんだ。死んだ故郷の家族からも師匠からち貰ったことがないから、そういうもんなのかと思っていた。",
      "source_box": [
        359,
        39,
        562,
        437
      ],
      "block_id": "render_0002_c6939900",
      "source_hash": "61b36b0badb8a5cb",
      "reference_text": "I have never received anything for my borthday before. I have never received anything from my late family back in my home or from Master, so I was wondering if that's how it goes.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_003",
      "page_order": 3,
      "source_text": "故郷の家族からも？そういった風習だったのですか？",
      "source_box": [
        94,
        29,
        219,
        243
      ],
      "block_id": "render_0003_fac43fd5",
      "source_hash": "d90578e1d75c1755",
      "reference_text": "Even your family from your home town? Was that the sort of custom you lived with?",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_004",
      "page_order": 4,
      "source_text": "いや。単に俺が大事にされていなかったんだろうな。",
      "source_box": [
        630,
        507,
        739,
        697
      ],
      "block_id": "ocr_0006_b82c7dc6",
      "source_hash": "d9e34f91abb15d1b",
      "reference_text": "No. I was simply never valued highly.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_005",
      "page_order": 5,
      "source_text": "俺の故郷は戦士の村でさ。弱い奴の居場所なんかなかった。",
      "source_box": [
        179,
        526,
        297,
        685
      ],
      "block_id": "ocr_0007_d7147905",
      "source_hash": "76d77cbc7ba4ffd0",
      "reference_text": "I came from a town of warriors. It was no place for weaklings.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_006",
      "page_order": 6,
      "source_text": "魔物相手になんたる様だ。シュトルツを見習え。",
      "source_box": [
        474,
        921,
        590,
        1177
      ],
      "block_id": "render_0006_1ceba97d",
      "source_hash": "0e0480f564ccb358",
      "reference_text": "What a mess you lot are against a monster. Learn from Stolz.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_009",
      "line_id": "009_007",
      "page_order": 7,
      "source_text": "怪我どころか返り血一つ、泥一つさえ跳ねていない。",
      "source_box": [
        92,
        976,
        219,
        1113
      ],
      "block_id": "ocr_0010_0091b2d3",
      "source_hash": "05e382e7e8a88e33",
      "reference_text": "Let alone an injury, he has not caused a single bit of blood or mud to splatter on him.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    }
  ]
}
