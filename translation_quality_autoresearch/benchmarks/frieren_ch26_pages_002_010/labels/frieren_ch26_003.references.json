        30,
        184,
        166
      ],
      "block_id": "ocr_0004_6beccf3b",
      "source_hash": "42b3906acd4ad8ea",
      "reference_text": "Fufufu. Fern always fails to follow through doesn't she?",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_005",
      "page_order": 5,
      "source_text": "私、何も準備していませんよ。",
