      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_011",
      "page_order": 11,
      "source_text": "何？",
      "source_box": [
