      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_009",
      "page_order": 9,
      "source_text": "服だけ溶かす薬。",
      "source_box": [
