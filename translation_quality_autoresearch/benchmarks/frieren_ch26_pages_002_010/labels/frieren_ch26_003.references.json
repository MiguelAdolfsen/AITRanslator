        282
      ],
      "block_id": "ocr_0002_4ce069aa",
      "source_hash": "eaa5fe33994ec0b9",
      "reference_text": "Can't you just buy something in this town?",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_003",
      "page_order": 3,
      "source_text": "シュタルク様の欲しいものがわかりません。",
      "source_box": [
        350,
        24,
        435,
        172
      ],
      "block_id": "ocr_0003_92fa6756",
      "source_hash": "2b5d8690fce665f0",
      "reference_text": "I do not know what it is Stark-sama desires.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_004",
      "page_order": 4,
      "source_text": "いっふっふ。フェルンは詰めが甘いね。",
