        300,
        772,
        472
      ],
      "block_id": "ocr_0005_1730d5dc",
      "source_hash": "83dbd89520f9ee27",
      "reference_text": "I... have not prepared anything.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_006",
      "page_order": 6,
      "source_text": "フリーレン様のせいなんですけど。",
      "source_box": [
        139,
        292,
        193,
        473
      ],
      "block_id": "ocr_0006_2fc4123e",
      "source_hash": "16afc16fd17d098e",
      "reference_text": "That is only because of Frieren-sama, though.",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_007",
      "page_order": 7,
      "source_text": "ちなみにフリーレン様は何をプレゼントするつもりなんですか？",
      "source_box": [
        675,
        540,
        782,
        731
      ],
      "block_id": "ocr_0007_be3b6ff0",
      "source_hash": "5af1fae0a66dd275",
      "reference_text": "By the way, what do you plan to present him, Frieren-sama?",
      "alignment_confidence": "high",
      "reference_role": "speech",
      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_008",
      "page_order": 8,
      "source_text": "とっておきだよ。",
      "source_box": [
        447,
        547,
        468,
        703
      ],
      "block_id": "ocr_0008_a42d983c",
      "source_hash": "b659b0f04a6c441e",
