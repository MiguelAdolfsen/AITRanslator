      "skip_reference": false,
      "skip_reason": "",
      "notes": ""
    },
    {
      "page_id": "frieren_ch26_003",
      "line_id": "003_010",
      "page_order": 10,
      "source_text": "男ってのはね、こういうの渡しておけば喜ぶんだよ。",
      "source_box": [
        389,
